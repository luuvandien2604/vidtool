# ==============================================================================
# videotool Environment Configuration Example
# ==============================================================================

# Azure Speech TTS (Phase 2F Audio Provider)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# --- Anthropic Claude API ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Narration scriptwriter model (default: claude-sonnet-5)
ANTHROPIC_NARRATION_MODEL=claude-sonnet-5
# Fact verification model — can use a stronger reasoning model if desired
# (e.g. claude-opus-4-8 for higher-stakes verification)
ANTHROPIC_VERIFICATION_MODEL=claude-sonnet-5

# --- Google Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here
# Narration scriptwriter model.
# Use "-latest" aliases (e.g. gemini-flash-latest) to auto-track the current GA release and avoid staleness.
# For a pinned (non-moving) version, use gemini-3.5-flash as of August 2026.
GEMINI_NARRATION_MODEL=gemini-flash-latest
# Fact verification model — can use a stronger reasoning model if desired
# (e.g. gemini-3.1-pro-preview for higher-stakes verification)
# Use "-latest" aliases to auto-track the current GA release and avoid staleness.
GEMINI_VERIFICATION_MODEL=gemini-flash-latest
