# ==============================================================================
# videotool Environment Configuration Example
# ==============================================================================

# Azure Speech TTS (Phase 2F Audio Provider)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# Anthropic Claude API (Phase 4 Narration Scriptwriter & Fact Verifier)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_NARRATION_MODEL=claude-3-7-sonnet-20250219

# Google Gemini API (Phase 4 Narration Scriptwriter & Fact Verifier with Google Search Grounding)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_NARRATION_MODEL=gemini-2.5-flash
